# Copiar este archivo como .env y reemplazar todos los valores change-me.

# Aplicacion
APP_NAME=TaiLil ERP
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=TaiLil_ERP
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Autenticacion JWT y sesiones
JWT_ALGORITHM=HS256
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
JWT_ACCESS_COOKIE_NAME=tailil_access_token
JWT_REFRESH_COOKIE_NAME=tailil_refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Seguridad y recuperacion de contrasenas
PASSWORD_HASH_ALGORITHM=argon2id
PASSWORD_RESET_SECRET=change-me
PASSWORD_RESET_EXPIRE_MINUTES=30

# Usuario administrador inicial de instalacion
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me

# Acceso desde el navegador durante el desarrollo local
CORS_ORIGINS=http://localhost:3000
